# ── App & Pilot Sandbox Settings ──────────────────────────────────
APP_ENV=staging
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PILOT_MODE=true

# ── Feature Flags ────────────────────────────────────────────────
ENABLE_LLM=true
ENABLE_RECOMMENDATIONS=true
ENABLE_CONVERSATION_ASSISTANT=true
ENABLE_ANALYTICS=true
ENABLE_MODEL_GOVERNANCE=true

# ── Frontend ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PILOT_MODE=true

# ── Database ─────────────────────────────────────────────────────
POSTGRES_DB=broker_insight_pilot
POSTGRES_USER=broker_user
POSTGRES_PASSWORD=broker_secure_password_replace_in_prod
DATABASE_URL=postgresql+asyncpg://broker_user:broker_secure_password_replace_in_prod@localhost:5432/broker_insight_pilot

# ── JWT ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_generate_a_random_32_byte_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Optimization & Caching (Phase 25) ─────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=3600

# ── ML & Synthetic Cohort ─────────────────────────────────────────
SYNTHETIC_CUSTOMER_COUNT=250
ML_MODEL_VERSION=1.0.0

# ── Security & Rate Limits ────────────────────────────────────────
ENABLE_DATA_MASKING=true
RATE_LIMIT_LOGIN_PER_MIN=15
RATE_LIMIT_AI_PER_MIN=30
